@model LIBRARY_PLUS.Models.Emprunt

@{
    ViewData["Title"] = "Détails de l’emprunt";

    var aujourdHui = DateTime.Today;
    var joursRestants = (Model.DateRemisePrevue.Date - aujourdHui).Days;

    bool estRendu = Model.DateRemiseEffective.HasValue;

    bool enRetard = estRendu
        ? Model.DateRemiseEffective!.Value.Date > Model.DateRemisePrevue.Date
        : Model.DateRemisePrevue.Date < aujourdHui;

    bool remiseProche = !enRetard
        && !estRendu
        && joursRestants >= 0
        && joursRestants <= 2;

    var statusText = estRendu ? "Rendu"
        : enRetard ? "En retard"
        : remiseProche ? "Alerte J-2"
        : "En cours";

    var statusClass = estRendu ? "status-returned"
        : enRetard ? "status-late"
        : remiseProche ? "status-warning"
        : "status-current";
}

<style>
    .details-page {
        max-width: 950px;
        margin: 0 auto;
    }

    .details-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .back-link {
        color: #0f172a;
        font-size: 22px;
        text-decoration: none;
    }

    .details-title {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .details-subtitle {
        color: #64748b;
        margin: 3px 0 0;
    }

    .details-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

    .emprunt-hero {
        background: linear-gradient(135deg, #213c9b, #1d4ed8);
        color: white;
        padding: 36px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .emprunt-icon {
        width: 112px;
        height: 112px;
        border-radius: 24px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 44px;
    }

    .emprunt-title {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .emprunt-sub {
        font-size: 17px;
        opacity: 0.92;
        margin-bottom: 14px;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-current {
        background: #dbeafe;
        color: #2563eb;
    }

    .status-warning {
        background: #ffedd5;
        color: #ea580c;
    }

    .status-late {
        background: #fee2e2;
        color: #dc2626;
    }

    .status-returned {
        background: #dcfce7;
        color: #15803d;
    }

    .details-body {
        padding: 34px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .info-item {
        background: #f8fafc;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .info-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-student {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-book {
        background: #ecfdf5;
        color: #16a34a;
    }

    .icon-date {
        background: #faf5ff;
        color: #9333ea;
    }

    .icon-return {
        background: #fff7ed;
        color: #ea580c;
    }

    .icon-status {
        background: #fee2e2;
        color: #dc2626;
    }

    .icon-reservation {
        background: #eff6ff;
        color: #2563eb;
    }

    .info-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #0f172a;
        font-size: 17px;
        font-weight: 600;
    }

    .text-green {
        color: #16a34a;
    }

    .details-divider {
        border-top: 1px solid #e2e8f0;
        margin: 32px 0 28px;
    }

    .details-actions {
        display: flex;
        gap: 16px;
    }

    .btn-edit {
        background: #213c9b;
        color: white;
        text-decoration: none;
        padding: 14px 26px;
        border-radius: 10px;
        font-weight: 700;
    }

        .btn-edit:hover {
            background: #1d3588;
            color: white;
        }

    .btn-back {
        background: white;
        color: #0f172a;
        text-decoration: none;
        padding: 14px 26px;
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }
</style>

<div class="details-page">

    <div class="details-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="details-title">Détails de l’emprunt</h1>
            <p class="details-subtitle">Informations complètes</p>
        </div>
    </div>

    <div class="details-card">

        <div class="emprunt-hero">
            <div class="emprunt-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div>
                <div class="emprunt-title">
                    @Model.Livre?.Titre
                </div>

                <div class="emprunt-sub">
                    @Model.Etudiant?.Prenom @Model.Etudiant?.Nom — @Model.Etudiant?.Classe
                </div>

                <span class="status-badge @statusClass">
                    @statusText
                </span>
            </div>
        </div>

        <div class="details-body">

            <div class="info-grid">

                <div class="info-item">
                    <div class="info-icon icon-student">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>

                    <div>
                        <div class="info-label">Étudiant</div>
                        <div class="info-value">
                            @Model.Etudiant?.Prenom @Model.Etudiant?.Nom
                        </div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-book">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <div>
                        <div class="info-label">Livre</div>
                        <div class="info-value">@Model.Livre?.Titre</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-date">
                        <i class="fa-regular fa-calendar"></i>
                    </div>

                    <div>
                        <div class="info-label">Date d'emprunt</div>
                        <div class="info-value">@Model.DateEmprunt.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-date">
                        <i class="fa-regular fa-calendar-check"></i>
                    </div>

                    <div>
                        <div class="info-label">Date remise prévue</div>
                        <div class="info-value">@Model.DateRemisePrevue.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-return">
                        <i class="fa-solid fa-rotate-left"></i>
                    </div>

                    <div>
                        <div class="info-label">Date remise effective</div>
                        <div class="info-value @(estRendu ? "text-green" : "")">
                            @(estRendu? Model.DateRemiseEffective!.Value.ToString("dd/MM/yyyy") : "Non retourné")
                        </div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-reservation">
                        <i class="fa-regular fa-bookmark"></i>
                    </div>

                    <div>
                        <div class="info-label">Réservation</div>
                        <div class="info-value">
                            @(Model.IdReservation.HasValue ? $"Réservation #{Model.IdReservation}" : "Aucune")
                        </div>
                    </div>
                </div>

            </div>

            <div class="details-divider"></div>

            <div class="details-actions">
                <a asp-action="Edit"
                   asp-route-id="@Model.IdEmprunt"
                   class="btn-edit">
                    Modifier cet emprunt
                </a>

                <a asp-action="Index"
                   class="btn-back">
                    Retour à la liste
                </a>
            </div>

        </div>

    </div>

</div>