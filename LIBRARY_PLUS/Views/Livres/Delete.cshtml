@model LIBRARY_PLUS.Models.Livre

@{
    ViewData["Title"] = "Supprimer un livre";

    var auteurs = Model.AuteurLivres != null && Model.AuteurLivres.Any()
        ? string.Join(", ", Model.AuteurLivres
            .Where(al => al.Auteur != null)
            .Select(al => al.Auteur!.Nom + " " + al.Auteur!.Prenom))
        : "Aucun auteur";
}

<style>
    .delete-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .delete-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .back-link {
        color: #0f172a;
        font-size: 22px;
        text-decoration: none;
    }

    .delete-title {
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .delete-subtitle {
        color: #64748b;
        margin: 4px 0 0;
    }

    .delete-card {
        background: white;
        border: 1px solid #fecaca;
        border-radius: 16px;
        overflow: hidden;
    }

    .warning-box {
        background: #fef2f2;
        padding: 30px;
        border-bottom: 1px solid #fecaca;
        display: flex;
        gap: 18px;
        align-items: center;
    }

    .warning-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .warning-title {
        font-size: 22px;
        font-weight: 700;
        color: #991b1b;
        margin-bottom: 4px;
    }

    .warning-text {
        color: #7f1d1d;
        margin: 0;
    }

    .book-info {
        padding: 32px;
    }

    .book-name {
        font-size: 26px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .book-author {
        color: #64748b;
        margin-bottom: 26px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 40px;
    }

    .info-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 16px;
    }

    .info-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        color: #0f172a;
        font-weight: 600;
    }

    .status-available {
        color: #16a34a;
    }

    .status-unavailable {
        color: #dc2626;
    }

    .delete-actions {
        padding: 26px 32px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        gap: 16px;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 14px 26px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-back {
        background: white;
        color: #0f172a;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 14px 26px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }
</style>

<div class="delete-page">

    <div class="delete-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="delete-title">Supprimer un livre</h1>
            <p class="delete-subtitle">Confirmation de suppression</p>
        </div>
    </div>

    <div class="delete-card">

        <div class="warning-box">
            <div class="warning-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <div class="warning-title">Es-tu sûr de vouloir supprimer ce livre ?</div>
                <p class="warning-text">
                    Cette action est définitive et supprimera le livre du catalogue.
                </p>
            </div>
        </div>

        <div class="book-info">
            <div class="book-name">@Model.Titre</div>
            <div class="book-author">
                <i class="fa-regular fa-user me-2"></i>
                @auteurs
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">ISBN</div>
                    <div class="info-value">@Model.ISBN</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Catégorie</div>
                    <div class="info-value">@Model.Categorie?.NomCategorie</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Année de publication</div>
                    <div class="info-value">@Model.AnneePublication</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Disponibilité</div>
                    <div class="info-value @(Model.Disponible ? "status-available" : "status-unavailable")">
                        @(Model.Disponible ? "Disponible" : "Indisponible")
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="IdLivre" />

            <div class="delete-actions">
                <button type="submit" class="btn-delete">
                    <i class="fa-solid fa-trash-can"></i>
                    Confirmer la suppression
                </button>

                <a asp-action="Index" class="btn-back">
                    Retour à la liste
                </a>
            </div>
        </form>

    </div>
</div>