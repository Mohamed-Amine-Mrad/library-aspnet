@model LIBRARY_PLUS.Models.Categorie

@{
    ViewData["Title"] = "Ajouter une catégorie";
}

<style>
    .form-page {
        max-width: 760px;
        margin: 0 auto;
    }

    .form-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .back-link {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        text-decoration: none;
        font-size: 22px;
        transition: 0.2s;
    }

        .back-link:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .form-title {
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .form-subtitle {
        color: #64748b;
        font-size: 16px;
        margin: 4px 0 0;
    }

    .form-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 38px 40px;
    }

    .form-label {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 10px;
        font-size: 15px;
    }

    .required {
        color: #dc2626;
    }

    .modern-input {
        height: 58px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 0 20px;
        font-size: 16px;
        color: #334155;
        width: 100%;
    }

    .modern-textarea {
        min-height: 130px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 18px 20px;
        font-size: 16px;
        color: #334155;
        width: 100%;
        resize: vertical;
    }

        .modern-input:focus,
        .modern-textarea:focus {
            border-color: #213c9b;
            box-shadow: 0 0 0 4px rgba(33,60,155,0.08);
            outline: none;
        }

    .form-divider {
        border-top: 1px solid #e2e8f0;
        margin: 28px 0 32px;
    }

    .form-actions {
        display: flex;
        gap: 18px;
    }

    .btn-create {
        background: #213c9b;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 14px 30px;
        font-weight: 700;
        font-size: 16px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-create:hover {
            background: #1d3588;
            color: white;
        }

    .btn-cancel {
        background: white;
        color: #0f172a;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 14px 30px;
        font-weight: 600;
        font-size: 16px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background: #f8fafc;
            color: #0f172a;
        }

    .text-danger {
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }
</style>

<div class="form-page">

    <div class="form-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="form-title">Ajouter une catégorie</h1>
            <p class="form-subtitle">Remplissez les informations de la nouvelle catégorie</p>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="NomCategorie" class="form-label">
                    Nom de la catégorie <span class="required">*</span>
                </label>
                <input asp-for="NomCategorie" class="modern-input" placeholder="Ex: Développement" />
                <span asp-validation-for="NomCategorie" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">
                    Description <span class="required">*</span>
                </label>
                <textarea asp-for="Description"
                          class="modern-textarea"
                          placeholder="Ex: Livres sur le développement logiciel"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-divider"></div>

            <div class="form-actions">
                <button type="submit" class="btn-create">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Créer
                </button>

                <a asp-action="Index" class="btn-cancel">Annuler</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}