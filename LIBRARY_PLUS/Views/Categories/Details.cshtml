@model LIBRARY_PLUS.Models.Categorie

@{
    ViewData["Title"] = "Détails de la catégorie";
}

<style>
    .details-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .details-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .back-link {
        color: #0f172a;
        font-size: 22px;
        text-decoration: none;
    }

    .details-title {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .details-subtitle {
        color: #64748b;
        margin: 3px 0 0;
    }

    .details-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

    .category-hero {
        background: linear-gradient(135deg, #213c9b, #1d4ed8);
        color: white;
        padding: 36px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .category-icon {
        width: 110px;
        height: 110px;
        border-radius: 22px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
    }

    .category-name {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .category-sub {
        font-size: 16px;
        opacity: 0.92;
    }

    .details-body {
        padding: 34px;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 18px;
    }

    .description-box {
        background: #f8fafc;
        border-radius: 14px;
        padding: 24px;
        color: #475569;
        line-height: 1.8;
        font-size: 16px;
    }

    .details-divider {
        border-top: 1px solid #e2e8f0;
        margin: 32px 0;
    }

    .info-card {
        background: #f8fafc;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .info-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .info-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #0f172a;
        font-size: 18px;
        font-weight: 700;
    }

    .details-actions {
        display: flex;
        gap: 16px;
        margin-top: 34px;
    }

    .btn-edit {
        background: #213c9b;
        color: white;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 10px;
        font-weight: 700;
    }

        .btn-edit:hover {
            background: #1d3588;
            color: white;
        }

    .btn-back {
        background: white;
        color: #0f172a;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }
</style>

<div class="details-page">

    <div class="details-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="details-title">Détails de la catégorie</h1>
            <p class="details-subtitle">Informations complètes</p>
        </div>
    </div>

    <div class="details-card">

        <div class="category-hero">

            <div class="category-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
                <div class="category-name">
                    @Model.NomCategorie
                </div>

                <div class="category-sub">
                    Catégorie enregistrée dans la bibliothèque
                </div>
            </div>

        </div>

        <div class="details-body">

            <div class="section-title">
                Description
            </div>

            <div class="description-box">
                @Model.Description
            </div>

            <div class="details-divider"></div>

            <div class="info-card">

                <div class="info-icon">
                    <i class="fa-solid fa-book"></i>
                </div>

                <div>
                    <div class="info-label">Nom de la catégorie</div>
                    <div class="info-value">@Model.NomCategorie</div>
                </div>

            </div>

            <div class="details-actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.IdCategorie"
                   class="btn-edit">
                    Modifier cette catégorie
                </a>

                <a asp-action="Index"
                   class="btn-back">
                    Retour à la liste
                </a>

            </div>

        </div>

    </div>

</div>