@model IEnumerable<LIBRARY_PLUS.Models.Auteur>

@{
    ViewData["Title"] = "Auteurs";
}

<style>
    .authors-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
    }

    .authors-count {
        color: #64748b;
        font-size: 18px;
        font-weight: 500;
    }

    .add-author-btn {
        background: #213c9b;
        color: white;
        border-radius: 12px;
        padding: 13px 24px;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .add-author-btn:hover {
            color: white;
            background: #1d3588;
        }

    .search-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 30px;
        margin-bottom: 30px;
    }

    .search-input-wrapper {
        position: relative;
        max-width: 580px;
    }

    .search-icon {
        position: absolute;
        left: 18px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 18px;
    }

    .author-search {
        height: 52px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 0 18px 0 54px;
        font-size: 16px;
        color: #334155;
        width: 100%;
        background: white;
    }

        .author-search:focus {
            outline: none;
            border-color: #213c9b;
            box-shadow: 0 0 0 4px rgba(33,60,155,0.08);
        }

    .table-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
    }

    .authors-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .authors-table thead {
            background: #f1f5f9;
        }

        .authors-table th {
            padding: 18px 30px;
            color: #64748b;
            font-weight: 700;
            font-size: 16px;
        }

        .authors-table td {
            padding: 22px 30px;
            color: #475569;
            font-size: 16px;
            border-top: 1px solid #e2e8f0;
            vertical-align: middle;
        }

    .author-name {
        color: #0f172a;
        font-weight: 500;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 18px;
    }

        .actions a {
            text-decoration: none;
            font-size: 18px;
        }

    .action-view {
        color: #2563eb;
    }

    .action-edit {
        color: #16a34a;
    }

    .action-delete {
        color: #dc2626;
    }

    .authors-table tbody tr:hover {
        background: #f8fafc;
    }
</style>

<div class="authors-top">
    <div class="authors-count">@Model.Count() auteur(s) trouvé(s)</div>

    <a asp-action="Create" class="add-author-btn">
        <i class="fa-solid fa-plus"></i>
        Ajouter un auteur
    </a>
</div>

<div class="search-card">
    <div class="search-input-wrapper">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input id="authorSearch"
               type="text"
               class="author-search"
               placeholder="Rechercher un auteur..." />
    </div>
</div>

<div class="table-card">
    <table class="authors-table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr class="author-row"
                    data-name="@($"{item.Nom} {item.Prenom}".ToLower())">

                    <td class="author-name">@item.Nom</td>
                    <td>@item.Prenom</td>

                    <td>
                        <div class="actions">
                            <a asp-action="Details" asp-route-id="@item.IdAuteur" class="action-view">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            <a asp-action="Edit" asp-route-id="@item.IdAuteur" class="action-edit">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.IdAuteur" class="action-delete">
                                <i class="fa-solid fa-trash-can"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        const authorSearch = document.getElementById("authorSearch");
        const authorRows = document.querySelectorAll(".author-row");

        authorSearch.addEventListener("input", function () {
            const search = authorSearch.value.toLowerCase().trim();

            authorRows.forEach(row => {
                const name = row.dataset.name;

                row.style.display = name.includes(search) ? "" : "none";
            });
        });
    </script>
}