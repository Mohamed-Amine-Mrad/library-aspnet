@model LIBRARY_PLUS.Models.Auteur

@{
    ViewData["Title"] = "Supprimer un auteur";
}

<style>
    .delete-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .delete-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .back-link {
        color: #0f172a;
        font-size: 22px;
        text-decoration: none;
    }

    .delete-title {
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .delete-subtitle {
        color: #64748b;
        margin: 4px 0 0;
    }

    .delete-card {
        background: white;
        border: 1px solid #fecaca;
        border-radius: 16px;
        overflow: hidden;
    }

    .warning-box {
        background: #fef2f2;
        padding: 30px;
        border-bottom: 1px solid #fecaca;
        display: flex;
        gap: 18px;
        align-items: center;
    }

    .warning-icon {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .warning-title {
        font-size: 22px;
        font-weight: 700;
        color: #991b1b;
        margin-bottom: 4px;
    }

    .warning-text {
        color: #7f1d1d;
        margin: 0;
    }

    .author-info {
        padding: 32px;
    }

    .author-fullname {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 28px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 40px;
    }

    .info-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 18px;
    }

    .info-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        color: #0f172a;
        font-weight: 600;
        font-size: 17px;
    }

    .delete-actions {
        padding: 26px 32px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        gap: 16px;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 14px 26px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-back {
        background: white;
        color: #0f172a;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        padding: 14px 26px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }
</style>

<div class="delete-page">

    <div class="delete-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="delete-title">Supprimer un auteur</h1>
            <p class="delete-subtitle">Confirmation de suppression</p>
        </div>
    </div>

    <div class="delete-card">

        <div class="warning-box">
            <div class="warning-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <div class="warning-title">
                    Es-tu sûr de vouloir supprimer cet auteur ?
                </div>

                <p class="warning-text">
                    Cette action est définitive et supprimera l'auteur de la bibliothèque.
                </p>
            </div>
        </div>

        <div class="author-info">

            <div class="author-fullname">
                @Model.Prenom @Model.Nom
            </div>

            <div class="info-grid">

                <div class="info-item">
                    <div class="info-label">Nom</div>
                    <div class="info-value">@Model.Nom</div>
                </div>

                <div class="info-item">
                    <div class="info-label">Prénom</div>
                    <div class="info-value">@Model.Prenom</div>
                </div>

            </div>

        </div>

        <form asp-action="Delete" method="post">

            <input type="hidden" asp-for="IdAuteur" />

            <div class="delete-actions">

                <button type="submit" class="btn-delete">
                    <i class="fa-solid fa-trash-can"></i>
                    Confirmer la suppression
                </button>

                <a asp-action="Index" class="btn-back">
                    Retour à la liste
                </a>

            </div>

        </form>

    </div>

</div>