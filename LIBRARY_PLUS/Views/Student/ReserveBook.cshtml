@model LIBRARY_PLUS.Models.Livre

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Réserver un livre";

    var auteurs = Model.AuteurLivres != null && Model.AuteurLivres.Any()
        ? string.Join(", ", Model.AuteurLivres
            .Where(al => al.Auteur != null)
            .Select(al => al.Auteur!.Prenom + " " + al.Auteur!.Nom))
        : "Auteur inconnu";
}

<style>
    .reserve-page {
        max-width: 900px;
    }

    .reserve-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

    .reserve-hero {
        background: linear-gradient(135deg, #213c9b, #1d4ed8);
        color: white;
        padding: 34px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .book-icon {
        width: 110px;
        height: 110px;
        border-radius: 22px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 44px;
    }

    .book-title {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .book-author {
        font-size: 17px;
        opacity: .95;
    }

    .reserve-body {
        padding: 34px;
    }

    .reserve-info {
        background: #fff7ed;
        border: 1px solid #fdba74;
        color: #c2410c;
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 28px;
        font-weight: 500;
    }

    .form-group-modern {
        display: flex;
        flex-direction: column;
        margin-bottom: 28px;
    }

        .form-group-modern label {
            color: #0f172a;
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 12px;
        }

        .form-group-modern input {
            height: 58px;
            border: 1px solid #dbe2ea;
            border-radius: 12px;
            padding: 0 18px;
            font-size: 16px;
            color: #334155;
        }

            .form-group-modern input:focus {
                outline: none;
                border-color: #213c9b;
                box-shadow: 0 0 0 4px rgba(33,60,155,0.08);
            }

    .reserve-actions {
        border-top: 1px solid #e2e8f0;
        padding-top: 28px;
        display: flex;
        gap: 16px;
    }

    .btn-reserve-submit {
        height: 54px;
        padding: 0 28px;
        border: none;
        border-radius: 10px;
        background: #fb3b08;
        color: white;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

        .btn-reserve-submit:hover {
            background: #ea3505;
        }

    .btn-back {
        height: 54px;
        padding: 0 28px;
        border-radius: 10px;
        background: white;
        color: #0f172a;
        border: 1px solid #dbe2ea;
        text-decoration: none;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }

    .text-danger {
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 600;
    }
</style>

<div class="reserve-page">
    <div class="reserve-card">

        <div class="reserve-hero">
            <div class="book-icon">
                <i class="fa-regular fa-bookmark"></i>
            </div>

            <div>
                <div class="book-title">@Model.Titre</div>
                <div class="book-author">@auteurs</div>
            </div>
        </div>

        <div class="reserve-body">

            <div class="reserve-info">
                <i class="fa-solid fa-circle-info me-2"></i>
                Choisissez la date souhaitée pour votre réservation. L'administration validera ensuite votre demande.
            </div>

            <form asp-controller="Student"
                  asp-action="ReserveBook"
                  asp-route-id="@Model.IdLivre"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group-modern">
                    <label for="dateReservation">Date de réservation *</label>

                    <input type="date"
                           id="dateReservation"
                           name="dateReservation"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           required />
                </div>

                <div class="reserve-actions">
                    <button type="submit" class="btn-reserve-submit">
                        <i class="fa-regular fa-bookmark"></i>
                        Confirmer la réservation
                    </button>

                    <a asp-controller="Student"
                       asp-action="Search"
                       class="btn-back">
                        Annuler
                    </a>
                </div>

            </form>

        </div>

    </div>
</div>