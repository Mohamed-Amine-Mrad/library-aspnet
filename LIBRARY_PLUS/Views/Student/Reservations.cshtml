@model IEnumerable<LIBRARY_PLUS.Models.Reservation>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Mes réservations";
}

<style>
    .reservation-count {
        color: #64748b;
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 28px;
    }

    .reservation-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 30px;
        margin-bottom: 20px;
    }

    .reservation-content {
        display: flex;
        gap: 28px;
        align-items: flex-start;
    }

    .book-cover {
        width: 120px;
        height: 160px;
        border-radius: 9px;
        background: linear-gradient(135deg, #213c9b, #1d4ed8);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        padding: 12px;
        flex-shrink: 0;
    }

    .reservation-main {
        flex: 1;
    }

    .reservation-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 14px;
    }

    .book-title {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 10px;
    }

    .book-author {
        color: #64748b;
        font-size: 18px;
        margin-bottom: 12px;
    }

    .book-category {
        color: #64748b;
        font-size: 16px;
        margin-bottom: 18px;
    }

    .reservation-date {
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        margin-bottom: 22px;
    }

    .status-badge {
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        background: #ffedd5;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .status-valid {
        background: #dcfce7;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

    .status-refused {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .message-box {
        border-radius: 10px;
        padding: 16px 18px;
        font-size: 16px;
        margin-bottom: 20px;
    }

    .message-pending {
        background: #fff7ed;
        border: 1px solid #fdba74;
        color: #c2410c;
    }

    .message-valid {
        background: #ecfdf5;
        border: 1px solid #86efac;
        color: #047857;
    }

    .message-refused {
        background: #fef2f2;
        border: 1px solid #fca5a5;
        color: #dc2626;
    }

    .cancel-btn {
        background: white;
        color: #dc2626;
        border: 1px solid #ef4444;
        border-radius: 10px;
        padding: 13px 22px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

        .cancel-btn:hover {
            background: #fef2f2;
            color: #dc2626;
        }

    .empty-state {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 34px;
        color: #64748b;
        font-size: 16px;
    }
</style>

<div class="reservation-count">
    @Model.Count(r => r.Statut == "En attente" || r.Statut == "Validée") réservation(s) active(s)
</div>

@if (Model.Any())
{
    @foreach (var item in Model)
    {
        var statut = item.Statut ?? "En attente";

        var statusClass = statut.ToLower().Contains("valid") ? "status-valid"
            : statut.ToLower().Contains("refus") ? "status-refused"
            : "status-pending";

        var messageClass = statut.ToLower().Contains("valid") ? "message-valid"
            : statut.ToLower().Contains("refus") ? "message-refused"
            : "message-pending";

        var message = statut.ToLower().Contains("valid")
            ? "Le livre est maintenant disponible pour vous. Venez le retirer à la bibliothèque."
            : statut.ToLower().Contains("refus")
                ? "Votre réservation a été refusée par l'administration."
                : "Votre réservation est en attente. Vous serez notifié dès que le livre sera disponible.";

        <div class="reservation-card">
            <div class="reservation-content">

                <div class="book-cover">
                    @(item.Livre?.Titre?.Length > 22 ? item.Livre.Titre.Substring(0, 22) : item.Livre?.Titre)
                </div>

                <div class="reservation-main">

                    <div class="reservation-head">
                        <div>
                            <div class="book-title">@item.Livre?.Titre</div>
                            <div class="book-author">Livre réservé</div>
                            <div class="book-category">@item.Livre?.Categorie?.NomCategorie</div>

                            <div class="reservation-date">
                                <i class="fa-regular fa-calendar"></i>
                                Réservé le @item.DateReservation.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <span class="status-badge @statusClass">
                            @statut
                        </span>
                    </div>

                    <div class="message-box @messageClass">
                        @message
                    </div>

                    @if (statut == "En attente")
                    {
                        <a asp-controller="Student"
                           asp-action="CancelReservation"
                           asp-route-id="@item.IdReservation"
                           class="cancel-btn">
                            <i class="fa-solid fa-xmark"></i>
                            Annuler la réservation
                        </a>
                    }

                </div>

            </div>
        </div>
    }
}
else
{
    <div class="empty-state">
        Vous n’avez aucune réservation pour le moment.
    </div>
}