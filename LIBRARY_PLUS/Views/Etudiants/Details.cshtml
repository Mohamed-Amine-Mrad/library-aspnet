@model LIBRARY_PLUS.Models.Etudiant

@{
    ViewData["Title"] = "Détails de l'étudiant";

    var scoreLabel = Model.ScoreEmprunt >= 20 ? "Excellent"
        : Model.ScoreEmprunt >= 10 ? "Bien"
        : Model.ScoreEmprunt > 0 ? "Moyen"
        : "Nouveau";

    var scoreClass = Model.ScoreEmprunt >= 20 ? "score-excellent"
        : Model.ScoreEmprunt >= 10 ? "score-good"
        : Model.ScoreEmprunt > 0 ? "score-medium"
        : "score-low";
}

<style>
    .details-page {
        max-width: 950px;
        margin: 0 auto;
    }

    .details-header {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
    }

    .back-link {
        color: #0f172a;
        font-size: 22px;
        text-decoration: none;
    }

    .details-title {
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .details-subtitle {
        color: #64748b;
        margin: 3px 0 0;
    }

    .details-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

    .student-hero {
        background: linear-gradient(135deg, #213c9b, #1d4ed8);
        color: white;
        padding: 36px;
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .student-avatar {
        width: 112px;
        height: 112px;
        border-radius: 24px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 44px;
    }

    .student-name {
        font-size: 34px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .student-email {
        font-size: 17px;
        opacity: 0.92;
        margin-bottom: 14px;
    }

    .score-badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
    }

    .score-excellent {
        background: #dcfce7;
        color: #15803d;
    }

    .score-good {
        background: #dbeafe;
        color: #2563eb;
    }

    .score-medium {
        background: #fef3c7;
        color: #d97706;
    }

    .score-low {
        background: #fee2e2;
        color: #dc2626;
    }

    .details-body {
        padding: 34px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .info-item {
        background: #f8fafc;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .info-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .icon-name {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-email {
        background: #ecfdf5;
        color: #16a34a;
    }

    .icon-class {
        background: #faf5ff;
        color: #9333ea;
    }

    .icon-score {
        background: #fff7ed;
        color: #ea580c;
    }

    .info-label {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .info-value {
        color: #0f172a;
        font-size: 17px;
        font-weight: 600;
    }

    .details-divider {
        border-top: 1px solid #e2e8f0;
        margin: 32px 0 28px;
    }

    .details-actions {
        display: flex;
        gap: 16px;
    }

    .btn-edit {
        background: #213c9b;
        color: white;
        text-decoration: none;
        padding: 14px 26px;
        border-radius: 10px;
        font-weight: 700;
    }

        .btn-edit:hover {
            background: #1d3588;
            color: white;
        }

    .btn-back {
        background: white;
        color: #0f172a;
        text-decoration: none;
        padding: 14px 26px;
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #f8fafc;
            color: #0f172a;
        }
</style>

<div class="details-page">

    <div class="details-header">
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-left"></i>
        </a>

        <div>
            <h1 class="details-title">Détails de l'étudiant</h1>
            <p class="details-subtitle">Informations complètes</p>
        </div>
    </div>

    <div class="details-card">

        <div class="student-hero">
            <div class="student-avatar">
                <i class="fa-solid fa-user-graduate"></i>
            </div>

            <div>
                <div class="student-name">@Model.Prenom @Model.Nom</div>

                <div class="student-email">
                    <i class="fa-regular fa-envelope me-2"></i>
                    @Model.Email
                </div>

                <span class="score-badge @scoreClass">
                    Score @Model.ScoreEmprunt - @scoreLabel
                </span>
            </div>
        </div>

        <div class="details-body">

            <div class="info-grid">

                <div class="info-item">
                    <div class="info-icon icon-name">
                        <i class="fa-solid fa-signature"></i>
                    </div>

                    <div>
                        <div class="info-label">Nom complet</div>
                        <div class="info-value">@Model.Prenom @Model.Nom</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-email">
                        <i class="fa-regular fa-envelope"></i>
                    </div>

                    <div>
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-class">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <div>
                        <div class="info-label">Classe</div>
                        <div class="info-value">@Model.Classe</div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon icon-score">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>
                        <div class="info-label">Score emprunt</div>
                        <div class="info-value">@Model.ScoreEmprunt</div>
                    </div>
                </div>

            </div>

            <div class="details-divider"></div>

            <div class="details-actions">
                <a asp-action="Edit"
                   asp-route-id="@Model.IdEtudiant"
                   class="btn-edit">
                    Modifier cet étudiant
                </a>

                <a asp-action="Index"
                   class="btn-back">
                    Retour à la liste
                </a>
            </div>

        </div>

    </div>

</div>