@model LIBRARY_PLUS.Models.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - Library Plus</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #2563eb, #593cf3, #8b10f3);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-page {
            width: 100%;
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1fr 460px;
            align-items: center;
            gap: 80px;
            padding: 40px 12%;
        }

        .brand-side {
            color: white;
        }

        .register-logo {
            width: 150px;
            margin-bottom: 28px;
        }

        .brand-title {
            font-size: 54px;
            line-height: 1.05;
            font-weight: 800;
            margin: 0;
        }

            .brand-title span {
                color: #ffe600;
            }

        .brand-subtitle {
            font-size: 18px;
            margin: 16px 0 30px;
        }

        .feature {
            background: rgba(255,255,255,0.13);
            padding: 18px 22px;
            border-radius: 14px;
            margin-bottom: 14px;
            font-weight: 600;
        }

        .login-link-left {
            margin-top: 34px;
            font-size: 15px;
        }

            .login-link-left a {
                color: #ffe600;
                font-weight: 800;
            }

        .auth-card {
            background: rgba(255,255,255,0.92);
            border-radius: 20px;
            padding: 34px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.22);
        }

            .auth-card h2 {
                margin: 0 0 8px;
                font-size: 28px;
                color: #1f2937;
            }

            .auth-card p {
                margin-bottom: 22px;
                color: #64748b;
            }

        label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 7px;
        }

        .form-control {
            width: 100%;
            height: 44px;
            border-radius: 10px;
            border: 1px solid #d8dce5;
            padding: 0 14px;
            font-size: 14px;
            outline: none;
        }

            .form-control:focus {
                border-color: #7437f5;
                box-shadow: 0 0 0 3px rgba(116,55,245,0.12);
            }

        .form-group {
            margin-bottom: 15px;
        }

        .terms {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #64748b;
            font-size: 13px;
            margin: 20px 0;
        }

            .terms a {
                color: #8b10f3;
                font-weight: 700;
                text-decoration: none;
            }

        .btn-auth {
            width: 100%;
            border: none;
            height: 50px;
            border-radius: 10px;
            color: white;
            font-weight: 800;
            background: linear-gradient(90deg, #4f46e5, #a713f4);
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(79,70,229,0.28);
        }

        .text-danger {
            color: #dc2626;
            font-size: 13px;
        }

        .validation-summary-errors {
            color: #dc2626;
            margin-bottom: 12px;
            font-size: 14px;
        }

        @@media (max-width: 900px) {
            .auth-page {
                grid-template-columns: 1fr;
                gap: 30px;
                padding: 30px;
            }

            .brand-title {
                font-size: 42px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-page">

        <div class="brand-side">
            <img src="~/images/logo.png" class="register-logo" alt="Library Plus Logo" />

            <h1 class="brand-title">
                Join<br />
                <span>Library Plus</span>
            </h1>

            <div class="brand-subtitle">
                Create your account and discover a new way to read
            </div>

            <div class="feature">⭐ Unlimited access to the catalog</div>
            <div class="feature">📘 Track your loans</div>
            <div class="feature">✅ Online reservations</div>

            <div class="login-link-left">
                Already a member?
                <a asp-action="Login">Login</a>
            </div>
        </div>

        <div class="auth-card">
            <h2>Create account</h2>
            <p>Fill in your information</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="All"></div>

                <div class="form-group">
                    <label asp-for="Prenom">First name</label>
                    <input asp-for="Prenom" class="form-control" placeholder="Jean" />
                    <span asp-validation-for="Prenom" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Nom">Last name</label>
                    <input asp-for="Nom" class="form-control" placeholder="Dupont" />
                    <span asp-validation-for="Nom" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="jean.dupont@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Classe">Class</label>
                    <input asp-for="Classe" class="form-control" placeholder="Example: 3A Informatique" />
                    <span asp-validation-for="Classe" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="********" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="********" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="terms">
                    <input type="checkbox" required />
                    <span>
                        I accept the <a href="#">terms of use</a> and
                        <a href="#">privacy policy</a>
                    </span>
                </div>

                <button type="submit" class="btn-auth">Create my account</button>
            </form>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>